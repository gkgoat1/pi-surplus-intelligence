{
  "name": "pi-surplus-intelligence-extension",
  "version": "0.1.0",
  "description": "Pi extension adding Surplus Intelligence, InferHub, and Cheaper Inference model providers",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./providers": "./providers.ts"
  },
  "keywords": [
    "pi-package",
    "surplus-intelligence",
    "inferhub",
    "cheaper-inference",
    "pi-extension"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.84.0",
    "@earendil-works/pi-coding-agent": ">=0.84.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@types/node": "^22.13.5",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "dependencies": {
    "ethers": "^6.17.0"
  }
}
